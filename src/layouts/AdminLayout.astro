---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "Admin | Warm Story" } = Astro.props;
const currentUser = Astro.locals.user;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <div class="admin-shell">
      <aside class="admin-sidebar">
        <a class="brand" href="/admin">Warm Story</a>
        <p class="admin-sidebar__eyebrow">Admin Panel</p>
        <nav class="admin-nav">
          <a class="admin-nav__link" href="/admin">Overview</a>
          <a class="admin-nav__link" href="/admin/projects">Projects</a>
          <a class="admin-nav__link" href="/admin/settings">Settings</a>
          <a class="admin-nav__link" href="/admin/about">About</a>
        </nav>
      </aside>

      <div class="admin-main">
        <header class="admin-topbar">
          <div>
            <p class="eyebrow">Authenticated Admin</p>
            <h1 class="admin-topbar__title">{title}</h1>
          </div>

          <div class="admin-userbox">
            <div class="admin-userbox__meta">
              <strong>{currentUser?.name ?? "Warm Story Admin"}</strong>
              <span>{currentUser?.email ?? "No email"}</span>
            </div>
            <button class="btn btn-secondary" id="admin-signout" type="button">Logout</button>
          </div>
        </header>

        <main class="admin-content">
          <slot />
        </main>
      </div>
    </div>

    <script>
      import { authClient } from "../lib/auth-client.js";

      const signoutButton = document.querySelector("#admin-signout");
      signoutButton?.addEventListener("click", async () => {
        await authClient.signOut();
        window.location.href = "/admin/login";
      });
    </script>
  </body>
</html>

