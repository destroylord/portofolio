---
import Layout from "../../layouts/Layout.astro";

const next = Astro.url.searchParams.get("next") || "/admin";
---

<Layout title="Admin Login | Warm Story" activePath="/" routePath="" lang="id">
  <section class="page-section" style="padding-top: 4rem;">
    <div class="content-card auth-card">
      <p class="eyebrow">Admin Area</p>
      <h1 class="editorial-title">Masuk untuk mengelola Warm Story.</h1>
      <p class="body-copy" style="margin-top: 1rem;">
        Gunakan akun admin yang sudah di-seed untuk masuk ke dashboard dan mulai mengelola konten portofolio.
      </p>

      <form class="auth-form" data-next={next} id="admin-login-form">
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" placeholder="admin@example.com" required />
        </div>

        <div class="field">
          <label for="password">Password</label>
          <input id="password" name="password" type="password" placeholder="••••••••" required />
        </div>

        <label class="auth-checkbox">
          <input id="rememberMe" name="rememberMe" type="checkbox" checked />
          <span>Keep me signed in</span>
        </label>

        <p class="auth-message" id="auth-message" hidden></p>

        <button class="btn btn-primary auth-submit" type="submit">
          <span class="auth-submit__label">Login</span>
        </button>
      </form>
    </div>
  </section>

  <script>
    import { authClient } from "../../lib/auth-client.js";

    const form = document.querySelector("#admin-login-form");
    const message = document.querySelector("#auth-message");
    const submitButton = document.querySelector(".auth-submit");
    const submitLabel = document.querySelector(".auth-submit__label");

    const setMessage = (text, isError = true) => {
      if (!message) return;
      message.hidden = !text;
      message.textContent = text;
      message.dataset.error = isError ? "true" : "false";
    };

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      setMessage("");

      const formData = new FormData(form);
      const email = String(formData.get("email") || "");
      const password = String(formData.get("password") || "");
      const rememberMe = formData.get("rememberMe") === "on";
      const next = form.dataset.next || "/admin";

      submitButton?.setAttribute("disabled", "true");
      if (submitLabel) submitLabel.textContent = "Logging in...";

      const { error } = await authClient.signIn.email({
        email,
        password,
        rememberMe,
        callbackURL: next,
      });

      submitButton?.removeAttribute("disabled");
      if (submitLabel) submitLabel.textContent = "Login";

      if (error) {
        setMessage(error.message || "Login gagal. Periksa kembali email dan password.");
        return;
      }

      window.location.href = next;
    });
  </script>
</Layout>

