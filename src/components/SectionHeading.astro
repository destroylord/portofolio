---
interface Props {
  eyebrow?: string;
  title: string;
  body?: string;
  align?: "left" | "center";
}

const { eyebrow, title, body, align = "left" } = Astro.props;
---

<div class:list={["section-heading", align === "center" && "section-heading--center"]}>
  {eyebrow && <p class="section-heading__eyebrow">{eyebrow}</p>}
  <h2 class="section-heading__title">{title}</h2>
  {body && <p class="section-heading__body">{body}</p>}
</div>

