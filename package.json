{
  "name": "portofolio",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "node ./dist/server/entry.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "auth:migrate": "node --env-file=.env.production scripts/better-auth-migrate.mjs",
    "auth:seed-admin": "node --env-file=.env.production scripts/seed-admin.mjs",
    "auth:check-db": "node --env-file=.env.production scripts/check-db-connection.mjs",
    "db:reset-app": "node --env-file=.env.production scripts/reset-database.mjs --force --mode=app",
    "db:reset-all": "node --env-file=.env.production scripts/reset-database.mjs --force --mode=all",
    "db:reset": "npm run db:reset-app",
    "db:reset-and-seed": "node --env-file=.env.production scripts/reset-database.mjs --force --mode=all && npm run db:push && npm run db:seed-content && npm run auth:seed-admin && npm run db:seed-projects",
    "db:seed-projects": "node --env-file=.env.production scripts/seed-projects.mjs",
    "db:seed-content": "node --env-file=.env.production scripts/seed-content.mjs",
    "db:generate": "drizzle-kit generate --config=drizzle.config.mjs",
    "db:push": "drizzle-kit push --config=drizzle.config.mjs",
    "db:studio": "drizzle-kit studio --config=drizzle.config.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^10.1.1",
    "@better-auth/drizzle-adapter": "^1.6.11",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.3.7",
    "better-auth": "^1.6.11",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "mysql2": "^3.22.3",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21"
  }
}
